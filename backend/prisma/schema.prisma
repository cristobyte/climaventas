// Prisma schema for ClimaVentas CRM
// ClimaTecnología - "Encuentra la comodidad que mereces"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: SQLite doesn't support enums, so we use String fields
// Valid Role values: AGENT, ANALYTICS, MANAGEMENT
// Valid CustomerStage values: PROSPECTING, PRE_SALES, SALES, POST_PURCHASE, SERVICE, FIDELITY
// Valid CustomerSource values: REFERRAL, WEBSITE, PARTNERSHIP, DIRECT, OTHER
// Valid ProductCategory values: SPLIT, INSTALLATION, MAINTENANCE, ACCESSORY
// Valid SaleStatus values: PENDING, APPROVED, COMPLETED, CANCELLED
// Valid InteractionType values: CALL, EMAIL, VISIT, WHATSAPP, NOTE
// Valid ReferralStatus values: PENDING, CONVERTED, EXPIRED
// Valid CommissionRuleType values: PRODUCT, AGENT, VOLUME, BONUS

// Users table - System users with roles
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  phone           String?
  role            String   @default("AGENT")
  commissionRate  Float    @default(0.05) @map("commission_rate")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  assignedCustomers Customer[]    @relation("AssignedAgent")
  sales             Sale[]
  interactions      Interaction[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

// Refresh tokens for JWT
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Customers table - Customer records with lifecycle stage
model Customer {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  region          String?
  stage           String   @default("PROSPECTING")
  source          String   @default("DIRECT")
  assignedAgentId String?  @map("assigned_agent_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  assignedAgent       User?        @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  sales               Sale[]
  interactions        Interaction[]
  referralsGiven      Referral[]   @relation("ReferrerCustomer")
  referralsReceived   Referral[]   @relation("ReferredCustomer")

  @@map("customers")
}

// Products table - HVAC products catalog
model Product {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  brand                String?
  model                String?
  price                Float
  commissionPercentage Float    @default(0.05) @map("commission_percentage")
  category             String
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  sales           Sale[]
  commissionRules CommissionRule[]

  @@map("products")
}

// Sales table - Sales transactions
model Sale {
  id               String   @id @default(cuid())
  customerId       String   @map("customer_id")
  agentId          String   @map("agent_id")
  productId        String   @map("product_id")
  quantity         Int      @default(1)
  unitPrice        Float    @map("unit_price")
  totalAmount      Float    @map("total_amount")
  commissionAmount Float    @default(0) @map("commission_amount")
  status           String   @default("PENDING")
  paymentMethod    String?  @map("payment_method")
  notes            String?
  saleDate         DateTime @default(now()) @map("sale_date")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id])
  agent    User     @relation(fields: [agentId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("sales")
}

// Interactions table - Customer interaction history
model Interaction {
  id          String    @id @default(cuid())
  customerId  String    @map("customer_id")
  userId      String    @map("user_id")
  type        String
  subject     String
  description String?
  scheduledAt DateTime? @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("interactions")
}

// Partnerships table - Business partnerships
model Partnership {
  id              String   @id @default(cuid())
  name            String
  contactName     String?  @map("contact_name")
  email           String?
  phone           String?
  partnershipType String?  @map("partnership_type")
  commissionRate  Float    @default(0.03) @map("commission_rate")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  referrals Referral[]

  @@map("partnerships")
}

// Referrals table - Referral tracking
model Referral {
  id                 String   @id @default(cuid())
  referrerCustomerId String?  @map("referrer_customer_id")
  referredCustomerId String   @map("referred_customer_id")
  partnershipId      String?  @map("partnership_id")
  status             String   @default("PENDING")
  bonusAmount        Float?   @map("bonus_amount")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  referrerCustomer Customer?    @relation("ReferrerCustomer", fields: [referrerCustomerId], references: [id])
  referredCustomer Customer     @relation("ReferredCustomer", fields: [referredCustomerId], references: [id])
  partnership      Partnership? @relation(fields: [partnershipId], references: [id])

  @@map("referrals")
}

// Commission Rules table - Fully configurable commission rules engine
model CommissionRule {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  ruleType             String    @map("rule_type")
  productId            String?   @map("product_id")
  agentId              String?   @map("agent_id")
  conditionJson        String?   @map("condition_json")
  commissionPercentage Float?    @map("commission_percentage")
  fixedBonusAmount     Float?    @map("fixed_bonus_amount")
  minSaleAmount        Float?    @map("min_sale_amount")
  maxSaleAmount        Float?    @map("max_sale_amount")
  minVolume            Int?      @map("min_volume")
  priority             Int       @default(0)
  isActive             Boolean   @default(true) @map("is_active")
  validFrom            DateTime? @map("valid_from")
  validUntil           DateTime? @map("valid_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  product Product? @relation(fields: [productId], references: [id])

  @@map("commission_rules")
}
